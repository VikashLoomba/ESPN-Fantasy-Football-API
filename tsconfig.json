{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": "mcp",
    "outDir": "dist",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "mcp/**/*.ts"
  ]
}
